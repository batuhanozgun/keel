{
  "permissions": {
    "ask": [
      "Edit(/02_kanon/kilitli/**)",
      "Write(/02_kanon/kilitli/**)",
      "NotebookEdit(/02_kanon/kilitli/**)",
      "Edit(/02_kanon/golden/**)",
      "Write(/02_kanon/golden/**)",
      "NotebookEdit(/02_kanon/golden/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/guard/file-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$CLAUDE_PROJECT_DIR/tools/guard/.aktif-rol\""
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$CLAUDE_PROJECT_DIR/tools/guard/.aktif-rol\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/guard/kapanis.sh\""
          }
        ]
      }
    ]
  }
}
